{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "cleanUrls": true,
  "regions": ["sin1"],
  "functions": {
    "api/calendar.js": { "includeFiles": "data/**" }
  },
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }] },
